generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(USER)
  wallet    Int      @default(0)
  avatar    String?
  wins      Int      @default(0)
  losses    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  friendshipsSent     Friendship[] @relation("FriendshipSender")
  friendshipsReceived Friendship[] @relation("FriendshipReceiver")
}

model Post {
  id                 Int      @id @default(autoincrement())
  title              String
  content            String
  status             String   @default("visible")
  moderationDecision String?
  moderationScore    Float?
  moderationReasons  String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  comments Comment[]
}

model Comment {
  id                 Int      @id @default(autoincrement())
  content            String
  status             String   @default("visible")
  moderationDecision String?
  moderationScore    Float?
  moderationReasons  String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Report {
  id            Int       @id @default(autoincrement())
  targetType    String
  targetId      Int
  reason        String
  reporterId    Int
  status        String    @default("pending")
  resolution    String?
  moderatorId   Int?
  moderatorNote String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ModerationLog {
  id          Int      @id @default(autoincrement())
  reportId    Int?
  targetType  String
  targetId    Int
  action      String
  reason      String?
  moderatorId Int
  createdAt   DateTime @default(now())
}

enum Role {
  ADMIN
  MODERATOR
  USER
}

model Friendship {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("FriendshipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}